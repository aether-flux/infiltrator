/// Returns `true` if the current session is **Wayland**
pub fn is_wayland() -> bool {
    std::env::var("XDG_SESSION_TYPE")
        .map(|s| s.eq_ignore_ascii_case("wayland"))
        .unwrap_or_else(|_| std::env::var("WAYLAND_DISPLAY").is_ok())
}
